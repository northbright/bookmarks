#diagnose-button { float: none; margin-bottom: 10px; margin-inline-start: 0=
px; margin-top: 20px; }

h1 { margin-top: 0px; overflow-wrap: break-word; color: var(--edge-primary-=
text-color); margin-bottom: 22px; }

