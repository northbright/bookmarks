ass=3D"o">:=3D</span><span class=3D"w"> </span><span class=3D"nx">exec</spa=
n><span class=3D"p">.</span><span class=3D"nf">Command</span><span class=3D=
"p">(</span><span class=3D"s">"ls"</span><span class=3D"p">,</span><span cl=
ass=3D"w"> </span><span class=3D"s">"-l"</span><span class=3D"p">)</span><s=
